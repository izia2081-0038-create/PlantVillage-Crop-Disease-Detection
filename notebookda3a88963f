    "def find_corrupt_images(dataframe, sample_size=None, seed=SEED):\n",
    "    paths = dataframe[\"filepath\"] if sample_size is None else dataframe[\"filepath\"].sample(n=sample_size, random_state=seed)\n",
    "    corrupt = []\n",
    "    for p in paths:\n",
    "        try:\n",
    "            with Image.open(p) as img:\n",
    "                img.verify()\n",
    "        except Exception:\n",
    "            corrupt.append(p)\n",
    "    return corrupt\n",
    "\n",
    "# Full sweep over the project-scope subset — adjust sample_size=... if this is too slow on your machine\n",
    "corrupt_files = find_corrupt_images(df_scope)\n",
    "print(f\"Checked {len(df_scope):,} images.\")\n",
    "print(f\"Corrupted / unreadable files found: {len(corrupt_files)}\")\n",
    "if corrupt_files:\n",
