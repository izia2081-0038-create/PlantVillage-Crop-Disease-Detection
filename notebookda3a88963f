   "source": [
    "# The PlantVillage archive is often nested a folder or two deep (e.g. dataset_path/PlantVillage/Tomato___Late_blight/...).\n",
    "# This helper walks the tree and returns the folder whose immediate children are the class folders themselves.\n",
    "\n",
    "def locate_class_root(base_path):\n",
    "    base_path = Path(base_path)\n",
    "    image_exts = (\".jpg\", \".jpeg\", \".png\", \".JPG\", \".JPEG\", \".PNG\")\n",
    "    parent_hits = []\n",
    "    for p in base_path.rglob(\"*\"):\n",
    "        if p.is_dir():\n",
    "            has_images = any((p / f.name).suffix in image_exts for f in p.iterdir() if f.is_file())\n",
    "            if has_images:\n",
    "                parent_hits.append(p.parent)\n",
    "    if not parent_hits:\n",
    "        raise FileNotFoundError(\"No class-folder structure found under the given path.\")\n",
    "    # The correct root is whichever parent shows up most often (i.e. contains the most class folders)\n",
    "    return Counter(parent_hits).most_common(1)[0][0]\n",
    "\n",
    "DATA_ROOT = locate_class_root(dataset_path)\n",
    "print(\"Resolved class-folder root:\", DATA_ROOT)"
   ]
