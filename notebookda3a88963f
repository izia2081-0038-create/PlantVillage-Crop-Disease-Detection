    "# Parse each label into plant species + condition + healthy/diseased flag.\n",
    "# PlantVillage folder names follow the pattern \"Plant___Condition\", e.g. \"Tomato___Early_blight\", \"Potato___healthy\".\n",
    "\n",
    "def parse_label(label):\n",
    "    parts = label.split(\"___\")\n",
    "    plant = parts[0].replace(\"_\", \" \").strip()\n",
    "    condition = parts[1].replace(\"_\", \" \").strip() if len(parts) > 1 else \"Unknown\"\n",
    "    is_healthy = \"healthy\" in condition.lower()\n",
    "    return pd.Series([plant, condition, is_healthy])\n",
    "\n",
    "df[[\"plant\", \"condition\", \"is_healthy\"]] = df[\"label\"].apply(parse_label)\n",
    "df.head(10)"
   ]
