    axes[row, 0].set_title(f\"{plant} - {status}\", fontsize=9, loc=\"left\")\n\n    plt.suptitle(\"Healthy vs Unhealthy samples by plant\", y=1.0, fontsize=13, fontweight=\"bold\")\n    plt.tight_layout()\n    plt.show()\n\n# Example usage:\nshow_sample_grid_per_plant_simple(df_scope, [\"Corn (maize)\", \"Potato\", \"Tomato\"], n_per_class=3)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-31T18:03:31.385058Z","iopub.execute_input":"2026-07-31T18:03:31.385371Z","iopub.status.idle":"2026-07-31T18:03:32.409377Z","shell.execute_reply.started":"2026-07-31T18:03:31.385345Z","shell.execute_reply":"2026-07-31T18:03:32.405953Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 900x1800 with 18 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":19},{"cell_type":"markdown","source":"### 3.4. Image Dimension & Aspect Ratio Check\n\nInput pipeline for CNN needs a target size to be defined. In order to check if the image sizes are same or not, we inspect a few of the images (examining all 15k+ images will take a lot of time).","metadata":{}},{"cell_type":"code","source":"SAMPLE_SIZE = 300\nsample_paths = df_scope[\"filepath\"].sample(n=min(SAMPLE_SIZE, len(df_scope)), random_state=SEED)\n\ndims = []\nfor p in sample_paths:\n    with Image.open(p) as img:\n        dims.append(img.size)  # (width, height)\n\ndims_df = pd.DataFrame(dims, columns=[\"width\", \"height\"])\ndims_df[\"aspect_ratio\"] = (dims_df[\"width\"] / dims_df[\"height\"]).round(2)\n\nprint(dims_df.describe())\nprint(\"\\nMost common resolution(s):\")\nprint(dims_df.groupby([\"width\", \"height\"]).size().sort_values(ascending=False).head())\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\nsns.histplot(dims_df[\"width\"], bins=20, ax=axes[0], color=\"#4c72b0\")\naxes[0].set_title(\"Image width distribution (sample)\")\nsns.histplot(dims_df[\"aspect_ratio\"], bins=20, ax=axes[1], color=\"#55a868\")\naxes[1].set_title(\"Aspect ratio distribution (sample)\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-31T17:58:29.733216Z","iopub.execute_input":"2026-07-31T17:58:29.733514Z","iopub.status.idle":"2026-07-31T17:58:31.266085Z","shell.execute_reply.started":"2026-07-31T17:58:29.733469Z","shell.execute_reply":"2026-07-31T17:58:31.265103Z"}},"outputs":[{"name":"stdout","text":"       width  height  aspect_ratio\ncount  300.0   300.0         300.0\nmean   256.0   256.0           1.0\nstd      0.0     0.0           0.0\nmin    256.0   256.0           1.0\n25%    256.0   256.0           1.0\n50%    256.0   256.0           1.0\n75%    256.0   256.0           1.0\nmax    256.0   256.0           1.0\n\nMost common resolution(s):\nwidth  height\n256    256       300\ndtype: int64\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"markdown","source":"### 3.5. Corrupted / Unreadable Image Check\n\nSome real-world image datasets may have truncated or corrupted files. This is something worth checking once during exploratory data analysis as opposed to when training.","metadata":{}},{"cell_type":"code","source":"def find_corrupt_images(dataframe, sample_size=None, seed=SEED):\n    paths = dataframe[\"filepath\"] if sample_size is None else dataframe[\"filepath\"].sample(n=sample_size, random_state=seed)\n    corrupt = []\n    for p in paths:\n        try:\n            with Image.open(p) as img:\n                img.verify()\n        except Exception:\n            corrupt.append(p)\n    return corrupt\n\n# Full sweep over the project-scope subset — adjust sample_size=... if this is too slow on your machine\ncorrupt_files = find_corrupt_images(df_scope)\nprint(f\"Checked {len(df_scope):,} images.\")\nprint(f\"Corrupted / unreadable files found: {len(corrupt_files)}\")\nif corrupt_files:\n    print(\"Examples:\", corrupt_files[:5])","metadata":{"tru